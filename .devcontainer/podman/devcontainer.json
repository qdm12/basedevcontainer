{
    // See https://containers.dev/implementors/json_reference/
    "name": "project-dev",
    // The image builds an unprivileged account (uid/gid 1000 by default, name `user`)
    // and runs as it. Keep this value in sync with the USERNAME build argument, and
    // with the /home/user paths below, if you rebuild the image with other values.
    "remoteUser": "user",
    "containerEnv": {
        "TZ": "", // User defined timezone
        "GH_TOKEN": "${localEnv:GH_TOKEN}", // GitHub token for GitHub CLI, used for `gh auth login` in the container
        "SSH_AUTH_SOCK": "/tmp/ssh-agent.sock", // Comment out if not using the SSH agent
        // DOCKER_BUILDKIT=0 because this image ships the buildx plugin: without it, `docker build`
        // is routed to a docker-container BuildKit builder, which podman's API cannot serve (the
        // builder container dies creating its cgroup, and leaves a buildx_buildkit_default corpse).
        // On the legacy builder `docker build --platform linux/arm64` builds and runs fine.
        "DOCKER_BUILDKIT": "0"
    },
    "build": {
        "dockerfile": "../Dockerfile",
        // The unprivileged account the image creates and runs as (see the README,
        // "Non-root user"). They must match "remoteUser" above and the /home/user
        // mount targets below. Rootless podman needs no DOCKER_GID: its socket already
        // belongs to you, and --userns=keep-id below maps your host UID into the container.
        "args": {
            "USERNAME": "user",
            "GROUP_NAME": "user",
            "USER_UID": "1000",
            "USER_GID": "1000"
        }
    },
    "runArgs": [
        // Note host.docker.internal is automatically set in Podman
        // ---
        // Run the container's uid 1000 as the host's uid 1000: the podman API socket
        // belongs to the host user, and files bind-mounted from the host keep working
        // permissions instead of landing in the subuid range. No effect on the files
        // the image owns, and podman-only: the Docker engine rejects this flag.
        "--userns=keep-id"
    ],
    "postCreateCommand": "~/.ssh.sh",
    // Mount the checkout at the SAME absolute path it has on the host. A path handed
    // to the host engine (`docker run -v $PWD/data:/data`, build contexts) then refers
    // to the same files inside and outside the container.
    "workspaceFolder": "${localWorkspaceFolder}",
    "mounts": [
        // Application code
        {
            "source": "${localWorkspaceFolder}",
            "target": "${localWorkspaceFolder}",
            "type": "bind"
        },
        // Zsh commands history persistence
        {
            "source": "${localEnv:HOME}/.zsh_history",
            "target": "/home/user/.zsh_history",
            "type": "bind"
        },
        // Git configuration file
        {
            "source": "${localEnv:HOME}/.gitconfig",
            "target": "/home/user/.gitconfig",
            "type": "bind"
        },
        // SSH agent socket forwarded from the host, so the private key
        // never enters the container. Host side should have the SSH_AUTH_SOCK
        // environment variable set as the path to the socket.
        {
            "source": "${localEnv:SSH_AUTH_SOCK}",
            "target": "/tmp/ssh-agent.sock",
            "type": "bind"
        },
        // Commented out in favor of using an SSH agent
        // SSH directory for Linux, OSX and WSL
        // On Linux and OSX, a symlink /mnt/ssh <-> ~/.ssh is
        // created in the container. On Windows, files are copied
        // from /mnt/ssh to ~/.ssh to fix permissions.
        // {
        //     "source": "${localEnv:HOME}/.ssh",
        //     "target": "/mnt/ssh",
        //     "type": "bind"
        // },
        // Known hosts, read from /etc/ssh/ssh_known_hosts by the OpenSSH client by default.
        // If the user binds mount ~/.ssh <-> /mnt/ssh, this duplicates known_hosts in both
        // ~/.ssh/known_hosts and /etc/ssh/ssh_known_hosts, which is fine.
        {
            "source": "${localEnv:HOME}/.ssh/known_hosts",
            "target": "/etc/ssh/ssh_known_hosts",
            "type": "bind"
        },
        // Commit signing using SSH.
        // With gpg.format=ssh git resolves user.signingkey to the public key file
        // to learn which identity to use, then asks the SSH agent for the signature.
        // Adapt the public key filename to your public key filename in case it's not
        // id_ed25519.pub. Comment out if ~/.ssh/id_ed25519.pub does not exist.
        {
            "source": "${localEnv:HOME}/.ssh/id_ed25519.pub",
            "target": "/home/user/.ssh/id_ed25519.pub",
            "type": "bind,readonly"
        },
        // Commit signatures display: allowed_signers is consulted by `git log`
        // if log.showSignature is set to true. It contains a list of public keys 
        // and the email addresses.
        // Comment out if ~/.ssh/allowed_signers does not exist.
        {
            "source": "${localEnv:HOME}/.ssh/allowed_signers",
            "target": "/home/user/.ssh/allowed_signers",
            "type": "bind,readonly"
        },
        // Machine-specific agent context
        {
            "source": "${localEnv:HOME}/AGENTS.md",
            "target": "/AGENTS.md",
            "type": "bind"
        },
        // Engine: the host's rootless podman, reached through its API socket and
        // mounted at Docker's canonical path - the socket also serves the Docker API,
        // so docker, docker compose and podman-remote all work with no DOCKER_HOST.
        // (buildx is the one thing podman's API cannot serve - see DOCKER_BUILDKIT above.)
        // This devcontainer holds clients only: no engine, no capabilities, no storage.
        // XDG_RUNTIME_DIR is /run/user/$UID; if your editor server does not export it,
        // set it to the value from running `echo "/run/user/$(id -u)"`.
        {
            "source": "${localEnv:XDG_RUNTIME_DIR}/podman/podman.sock",
            "target": "/var/run/docker.sock",
            "type": "bind"
        },
        // Container registry credentials for Docker.
        // Comment out if the file does not exist.
        {
            "source": "${localEnv:HOME}/.config/containers/auth.json",
            "target": "/home/user/.config/containers/auth.json",
            "type": "bind"
        }
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "IBM.output-colorizer",
                "eamodio.gitlens",
                "mhutchie.git-graph",
                "davidanson.vscode-markdownlint",
                "shardulm94.trailing-spaces",
                "alefragnani.Bookmarks",
                "Gruntfuggly.todo-tree",
                "mohsen1.prettify-json",
                "quicktype.quicktype",
                "spikespaz.vscode-smoothtype",
                "stkb.rewrap",
                "vscode-icons-team.vscode-icons",
                "ms-azuretools.vscode-docker",
                "github.copilot"
            ],
            "settings": {
                // General settings
                "files.eol": "\n",
                // Docker settings
                "remote.extensionKind": {
                    "ms-azuretools.vscode-docker": "workspace"
                }
            }
        }
    }
}